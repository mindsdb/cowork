{
  "name": "anton",
  "productName": "MindsHub Cowork",
  "version": "2.0.7",
  "minServerVersion": "",
  "description": "MindsHub Cowork — autonomous AI coworker",
  "author": "MindsDB",
  "license": "AGPL-3.0-only",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:debug": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron:debug\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite dev src/renderer",
    "dev:electron": "sleep 3 && VITE_DEV=1 electron $([ \"$(uname)\" = \"Linux\" ] && echo --ozone-platform=x11) dist/main/main/index.js",
    "dev:electron:debug": "sleep 3 && VITE_DEV=1 ANTON_OPEN_DEVTOOLS=1 electron $([ \"$(uname)\" = \"Linux\" ] && echo --ozone-platform=x11) dist/main/main/index.js",
    "build": "npm run build:main && npm run build:renderer",
    "prebuild:main": "node scripts/gen-build-channel.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build src/renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer && npm run typecheck:test",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:cowork-purity": "node scripts/check-cowork-purity.mjs",
    "test:e2e": "playwright test",
    "build:web": "BUILD_TARGET=web vite build src/renderer",
    "dev:web": "node scripts/dev-web.mjs",
    "start": "electron dist/main/main/index.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "bash ./scripts/dist-mac-unsigned.sh",
    "dist:mac:dmg-custom": "bash ./scripts/dist-mac-dmg-custom.sh",
    "release:mac:dmg-custom:notarized": "bash ./scripts/release-mac-custom-notarized.sh",
    "release:mac:pkg:notarized": "bash ./scripts/release-mac-pkg-notarized.sh",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:all": "npm run build && electron-builder --win --publish never",
    "release:win:local": "npm run dist:win",
    "rebuild": "electron-rebuild"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@electron/rebuild": "^4.1.0",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-keycloak/web": "^3.4.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "keycloak-js": "^26.2.4",
    "keytar": "^7.9.0",
    "marked": "^17.0.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "allowScripts": {
    "keytar@7.9.0": true
  }
}
