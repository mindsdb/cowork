{
  // Typechecks test files + test helpers, which the production configs
  // (tsconfig.main.json / tsconfig.json) deliberately exclude so they never
  // land in dist. Reuses the renderer config's DOM libs + bundler resolution;
  // no rootDir constraint, so tests may import helpers from test/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "test/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
