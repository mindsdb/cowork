#!/bin/bash
# Stage installer OAuth credentials outside the root-owned signed app so provisioning can delete them.
# Best-effort only: a staging failure must not fail the package installation.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_FILE="$SCRIPT_DIR/server-credentials.json"

log() {
  echo "[cowork-postinstall] $*" >&2
}

if [ ! -f "$SRC_FILE" ]; then
  log "no server-credentials.json packaged alongside postinstall — nothing to stage (dev/unsigned build?)"
  exit 0
fi

# Resolve homes with dscl; eval on an unsanitized username would allow shell injection.
home_dir_for() {
  dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $2}'
}

stage_for_console_user() {
  local user="$1" home="$2"
  local dest_dir="$home/.cowork-provision"
  local dest_file="$dest_dir/server-credentials.json"
  # The user-owned home may contain planted symlinks. Recreate the destination as root-owned,
  # write privately, then transfer ownership last so the user cannot replace entries during the copy.
  rm -rf "$dest_dir" || return 1
  mkdir -m 700 "$dest_dir" \
    && cp "$SRC_FILE" "$dest_file" \
    && chmod 600 "$dest_file" \
    && chown "$user:staff" "$dest_file" \
    && chown "$user:staff" "$dest_dir"
}

stage_shared_fallback() {
  # Without a console user, use a staff-readable shared fallback for the account that later launches the app.
  local dest_dir="/Library/Application Support/MindsHub Cowork/.provision"
  local dest_file="$dest_dir/server-credentials.json"
  install -d -o root -g staff -m 750 "$dest_dir" \
    && cp "$SRC_FILE" "$dest_file" \
    && chown root:staff "$dest_file" \
    && chmod 640 "$dest_file"
}

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
CONSOLE_HOME=""
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  CONSOLE_HOME="$(home_dir_for "$CONSOLE_USER")"
fi

if [ -n "$CONSOLE_HOME" ] && [ -d "$CONSOLE_HOME" ] && stage_for_console_user "$CONSOLE_USER" "$CONSOLE_HOME"; then
  log "staged credentials for console user $CONSOLE_USER"
elif stage_shared_fallback; then
  log "no usable console user session — staged credentials at the shared fallback location"
else
  log "failed to stage credentials anywhere — connectors will need manual reconfiguration until this is fixed"
fi

exit 0