{
  "narrow_below_px": 620,
  "list": {"indent_step": "24px", "mark_min_width": "18px", "mark_gap": "8px", "task_box": "16px"},
  "rules": [
    {"editor": [".doc-page"], "page": [".page"],
     "css": {"max-width": "760px", "padding-left": "56px", "padding-right": "56px", "padding-top": "36px",
             "font-size": "15px", "line-height": "1.65"}},
    {"editor": [".doc-root--narrow .doc-page"], "page": ["@media (max-width:619.98px) .page"],
     "css": {"--doc-gutter": "48px", "padding-top": "24px"}},
    {"editor": [".doc-title"], "page": [".page-title"],
     "css": {"font-size": "30px", "line-height": "1.2", "font-weight": "650", "letter-spacing": "-0.02em",
             "margin-top": "0", "margin-bottom": "6px"}},
    {"editor": [".doc-byline"], "page": [".meta"], "css": {"font-size": "12.5px", "margin-bottom": "22px"}},
    {"editor": [".doc-tab"], "page": ["nav.tabs a"], "css": {"font-size": "12.5px", "border-radius": "6px"}},
    {"editor": [".doc-p"], "page": [".tab>p"], "css": {"padding-top": "3px", "padding-bottom": "3px"}},
    {"editor": [".doc-h", ".doc-h--1"], "page": [".tab>h1"],
     "css": {"font-size": "24px", "line-height": "1.3", "font-weight": "650", "letter-spacing": "-0.01em",
             "margin-top": "30px", "padding-top": "3px", "padding-bottom": "3px"}},
    {"editor": [".doc-h", ".doc-h--2"], "page": [".tab>h2"],
     "css": {"font-size": "19px", "line-height": "1.35", "font-weight": "650", "letter-spacing": "-0.01em",
             "margin-top": "26px", "padding-top": "3px", "padding-bottom": "3px"}},
    {"editor": [".doc-h", ".doc-h--3"], "page": [".tab>h3"],
     "css": {"font-size": "16px", "line-height": "1.4", "font-weight": "620", "letter-spacing": "-0.01em",
             "margin-top": "18px", "padding-top": "2px", "padding-bottom": "2px"}},
    {"editor": [".doc-block:first-child .doc-h"], "page": [".tab>:is(h1,h2,h3):first-child"],
     "css": {"margin-top": "4px"}},
    {"editor": [".doc-li"], "page": [".tab li"], "css": {"padding-top": "2px", "padding-bottom": "2px"}},
    {"editor": [".doc-quote"], "page": [".tab>blockquote"],
     "css": {"margin-top": "4px", "margin-bottom": "4px", "padding-top": "2px", "padding-bottom": "2px",
             "padding-left": "14px"}},
    {"editor": [".doc-callout"], "page": [".callout"],
     "css": {"gap": "10px", "padding-top": "12px", "padding-left": "14px", "padding-right": "14px",
             "margin-top": "8px", "margin-bottom": "8px", "border-radius": "10px"}},
    {"editor": [".doc-callout__icon"], "page": [".callout-icon"], "css": {"margin-top": "3px"}},
    {"editor": [".doc-callout__title"], "page": [".callout-title"], "css": {"font-weight": "620"}},
    {"editor": [".doc-code"], "page": [".tab>pre"],
     "css": {"margin-top": "8px", "margin-bottom": "8px", "border-radius": "10px"}},
    {"editor": [".doc-code__text"], "page": ["pre code"],
     "css": {"padding-top": "12px", "padding-left": "14px", "font-size": "12.5px", "line-height": "1.6",
             "tab-size": "2"}},
    {"editor": [".doc-divider"], "page": [".tab>hr"], "css": {"margin-top": "18px", "margin-bottom": "18px"}},
    {"editor": [".doc-figure"], "page": [".tab>figure.image"], "css": {"margin-top": "10px", "margin-bottom": "10px"}},
    {"editor": [".doc-figure figcaption"], "page": ["figure.image figcaption"],
     "css": {"font-size": "12.5px", "margin-top": "6px"}},
    {"editor": [".doc-table"], "page": ["table"], "css": {"font-size": "13.5px", "line-height": "1.5"}},
    {"editor": [".doc-table th"], "page": ["th"], "css": {"font-size": "12.5px", "font-weight": "600", "min-width": "140px"}},
    {"editor": [".doc-table td"], "page": ["td"], "css": {"min-width": "140px"}},
    {"editor": [".doc-td"], "page": ["td"], "css": {"padding-top": "7px", "padding-left": "12px", "padding-right": "12px"}},
    {"editor": [".doc-chart"], "page": ["figure.chart"],
     "css": {"margin-top": "12px", "margin-bottom": "12px", "padding-top": "14px", "padding-left": "16px",
             "padding-bottom": "10px", "border-radius": "10px"}},
    {"editor": [".doc-chart__title"], "page": ["figure.chart figcaption"], "css": {"font-size": "14px"}},
    {"editor": [".doc-chart__legend"], "page": ["figure.chart .legend"], "css": {"font-size": "11px", "gap": "4px 14px"}},
    {"editor": [".doc-metrics"], "page": [".metrics"],
     "css": {"grid-template-columns": "repeat(auto-fit, minmax(140px, 1fr))", "gap": "10px", "margin-top": "10px"}},
    {"editor": [".doc-metric"], "page": [".metric"], "css": {"padding-top": "12px", "padding-left": "14px"}},
    {"editor": [".doc-metric__label"], "page": [".m-label"], "css": {"font-size": "12.5px"}},
    {"editor": [".doc-metric__value"], "page": [".m-value"],
     "css": {"font-size": "24px", "font-weight": "650", "letter-spacing": "-0.01em", "line-height": "1.25",
             "margin-top": "2px"}},
    {"editor": [".doc-metric__delta"], "page": [".m-delta"], "css": {"font-size": "11px", "margin-top": "2px"}},
    {"editor": [".doc-chip"], "page": [".chip"],
     "css": {"padding-left": "7px", "height": "1.5em", "border-radius": "6px", "font-size": "0.86em", "line-height": "1"}},
    {"editor": [".doc-editable code"], "page": ["code"],
     "css": {"font-size": "0.86em", "padding-top": "0.12em", "padding-left": "0.36em", "border-radius": "5px"}},
    {"editor": [".doc-editable strong"], "page": ["strong"], "css": {"font-weight": "620"}},
    {"editor": [".doc-editable a"], "page": ["a"], "css": {"text-underline-offset": "2px"}}
  ]
}
