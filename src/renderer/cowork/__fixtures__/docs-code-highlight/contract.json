  "anchors": {
    "python": {
      "code": "@cache\nclass User:\n    def greet(self, name='x'):\n        # say hi\n        return name and not None or 42",
      "expect": [
        [
          "@cache",
          "meta"
        ],
        [
          "class",
          "keyword"
        ],
        [
          "# say hi",
          "comment"
        ],
        [
          "'x'",
          "string"
        ],
        [
          "and",
          "keyword"
        ],
        [
          "None",
          "literal"
        ],
        [
          "42",
          "number"
        ]
      ]
    },
    "json": {
      "code": "{\"name\": \"anton\", \"count\": 3, \"ok\": true, \"tags\": null}",
      "expect": [
        [
          "\"name\"",
          "attr"
