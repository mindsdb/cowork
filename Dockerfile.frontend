# Static SPA only; ingress must route same-origin /api/v1 to cowork-server.
# Build with Dockerfile.frontend and expose port 8080.

FROM node:22-slim AS spa-builder
WORKDIR /build

# Copy lockfiles first so source changes reuse the dependency layer.
COPY package.json package-lock.json ./
# Skip native hooks; the web SPA has no native dependencies.
RUN npm ci --ignore-scripts

COPY . ./

# Leave service URL args empty to derive hosts from page origin at runtime; explicit overrides pin a host.
ARG VITE_MINDS_API_URL=
ARG VITE_KEYCLOAK_URL=
ARG VITE_POSTHOG_MINDSHUB_MAIN_PROJECT_TOKEN=
ARG VITE_APP_VERSION=
ENV VITE_MINDS_API_URL=${VITE_MINDS_API_URL} \
    VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL} \
    VITE_POSTHOG_MINDSHUB_MAIN_PROJECT_TOKEN=${VITE_POSTHOG_MINDSHUB_MAIN_PROJECT_TOKEN} \
    VITE_APP_VERSION=${VITE_APP_VERSION}
RUN npm run build:web

# Use the slim nginx image unless configuration requires a dynamic module; unused modules add dependencies.
# Update the base tag for security fixes rather than patching packages in this image.
FROM nginxinc/nginx-unprivileged:1.30-alpine-slim AS runtime

LABEL org.opencontainers.image.title="cowork-frontend"
LABEL org.opencontainers.image.source="https://github.com/mindsdb/cowork"
LABEL org.opencontainers.image.description="MindsHub Cowork SPA (static, nginx)"

COPY scripts/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=spa-builder /build/dist/renderer-web/ /usr/share/nginx/html/

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1"]
