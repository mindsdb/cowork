# Keycloak
# Defaults to dev environment (https://auth.staging.mindshub.ai/auth)
# Set to https://auth.mindshub.ai/auth for production
VITE_KEYCLOAK_URL=https://auth.staging.mindshub.ai/auth

# MindsHub API
# Defaults to dev environment (https://api.staging.mindshub.ai)
# Set to https://api.mindshub.ai for production
VITE_MINDS_API_URL=https://api.staging.mindshub.ai

# PostHog analytics (desktop + web)
# Get from PostHog → Project Settings → Project API Key
VITE_POSTHOG_MINDSHUB_MAIN_PROJECT_TOKEN=

# Local dev: skip the Keycloak login gate (web SPA on localhost).
# Keycloak only accepts registered redirect URIs, so an unregistered
# localhost port bounces with "Invalid parameter: redirect_uri".
# true or 1 = render without the wrapper. Dev-only — never set this
# in production images (it removes the login gate entirely).
# VITE_SKIP_AUTH=true
