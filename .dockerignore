# Both Dockerfiles build from the repo root and share these exclusions.

**/node_modules/
**/dist/
**/out/
**/release/
**/build/

**/.DS_Store
**/Thumbs.db
**/.vscode/
**/.idea/
**/.cursor/
**/.claude/
**/*.swp

# Exclude git history from build context.
**/.git/
**/.gitignore
**/.gitattributes
**/.github/

# Exclude credentials while retaining the .env.example setup template.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.pytest-workspace/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/scratchpad-venvs/
**/htmlcov/
**/.coverage
**/.coverage.*

**/.anton/
**/.cowork/

**/*.log
**/logs/

**/docs/web-port-audit.md
